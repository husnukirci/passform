{
  "name": "passform",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility-driven parts catalogue and ordering backend with a thin web client. Synthetic data; any resemblance to real makes, brands or companies is coincidental.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -- concurrently -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "dotenv -- npm run test:integration -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky",
    "db:migrate": "dotenv -- npm run db:migrate -w apps/api --",
    "data:generate": "dotenv -- npm run data:generate -w apps/api --",
    "data:generate-import": "dotenv -- npm run data:generate-import -w apps/api --",
    "db:seed": "dotenv -- npm run db:seed -w apps/api --",
    "db:setup": "npm run db:migrate && npm run data:generate && npm run db:seed && npm run index:rebuild",
    "index:rebuild": "dotenv -- npm run index:rebuild -w apps/api --"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
