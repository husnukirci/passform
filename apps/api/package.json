{
  "name": "@passform/api",
  "version": "0.0.0",
  "private": true,
  "description": "passform REST API (NestJS).",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate-migration": "drizzle-kit generate",
    "data:generate": "tsx scripts/generate.ts",
    "data:generate-import": "tsx scripts/generate-import.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@passform/contracts": "*",
    "@passform/domain": "*",
    "drizzle-orm": "^0.45.3",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}
